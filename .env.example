# EmailJS Configuration (Client-side integration)
# 1. Sign up for a free account at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> Copy the Service ID (e.g., service_xxxxxxx)
# 3. Create an Email Template -> Copy Template ID (e.g., template_xxxxxxx)
#    Template variables expected: {{name}}, {{email}}, {{subject}}, {{message}}
# 4. Under Account -> API Keys -> Copy your Public Key (e.g., user_xxxxxxx or abcd...)

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
